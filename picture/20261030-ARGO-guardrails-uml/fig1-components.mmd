%%{init: {"themeVariables": {"fontSize": "22px"}, "flowchart": {"nodeSpacing": 60, "rankSpacing": 80, "padding": 20}}}%%
%% Layered component view of the guardrails (ARGO multilingual branch 65395de87f)
flowchart TB
  classDef host fill:#fff3e0,stroke:#e08a00,stroke-width:2px
  classDef entry fill:#fffde7,stroke:#c9a800,stroke-width:2px
  classDef agent fill:#fce4ec,stroke:#c2185b,stroke-width:2px
  classDef sens fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
  classDef rules fill:#e3f2fd,stroke:#1e6fd9,stroke-width:2px
  classDef eng fill:#e1f5fe,stroke:#0277bd,stroke-width:3px

  subgraph L1["① Hosts"]
    direction LR
    CLI["tinicli<br/>(REPL · TUI)"]:::host
    GW["gateway<br/>(daemon)"]:::host
  end

  subgraph L2["② Entry points"]
    direction LR
    INST["install_guardrails_from_config<br/><i>once, at boot</i>"]:::entry
    GATE["pre-persist gate<br/><i>before the message is stored</i>"]:::entry
    LOOP["agent_loop<br/><i>every turn</i>"]:::entry
  end

  subgraph L3["③ agent — what runs in a turn"]
    direction LR
    MASK["SensitiveMasking<br/>mask / demask<br/>+ per-turn vault"]:::agent
    SET["GuardrailSet<br/>input · output<br/>tool_input · tool_output"]:::agent
    PG["prompt guard<br/>(CompiledGuard)"]:::agent
    CACHE["scan caches<br/>(skip scanned messages)"]:::agent
  end

  SG["④ sensitive<br/>SensitiveGuardrail + DetectorChain"]:::sens

  subgraph L5["⑤ rule sets"]
    direction LR
    PII["PII<br/>PiiSpanDetector<br/>13 countries + common"]:::rules
    PI["prompt injection<br/>PromptInjectionDetector"]:::rules
  end

  subgraph L6["⑥ engine and its lifetime"]
    direction LR
    ENG["PatternEngine · PatternFilter<br/>(domain-neutral)"]:::eng
    TS["TurnSlot · TurnGuard<br/>built once per turn, or pinned"]:::sens
  end

  CLI --> INST
  CLI --> GATE
  GW --> GATE
  CLI --> LOOP
  GW --> LOOP

  INST -- "fills" --> MASK
  INST -- "fills" --> SET
  GATE --> SET
  GATE --> PG
  LOOP --> MASK
  LOOP --> SET
  LOOP --> PG
  LOOP --> CACHE

  MASK -- "DetectorChain" --> SG
  SET -- "PII input · tool output" --> SG
  SG --> PII
  SG --> PI
  PG --> PI
  PII --> ENG
  PI --> ENG
  ENG -- "engine held in" --> TS
